# Checked out as LF regardless of the local core.autocrlf: CRLF breaks the
# gradlew shebang, and mixed endings make the diffs unreadable.
* text=auto eol=lf

# Windows batch files are the one thing that genuinely needs CRLF. The launchers that ship in the
# zip are .cmd; gradlew.bat is the .bat.
*.bat text eol=crlf
*.cmd text eol=crlf

*.jar binary
*.png binary

*.ico binary
