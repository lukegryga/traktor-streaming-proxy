# A sample, and never read: the real file is config.properties, next to this one, and the control
# panel at http://127.0.0.1:8088 writes it. Nothing here needs editing by hand, and a setting left
# out falls back to its default and appears once the panel saves it.
#
# Everything the panel manages is left out too - ports, log level, audio quality, library path and
# limit, the Traktor executable. These are the few worth knowing about.

# don't change: the account the crafted Beatport license is written for
beatport.accountId=1337338

# comma-separated list of enabled sources
# available: spotify,tidal,youtube
sources.enabled=spotify

# register an app at https://developer.spotify.com/dashboard with the redirect uri
# http://127.0.0.1:5589/callback and put its client id here. there is no secret to
# store, and no password: spotify authenticates in the browser on first start.
spotify.clientId=

# if you enable tidal, fill in your client id and secret
tidal.clientId=
tidal.clientSecret=
